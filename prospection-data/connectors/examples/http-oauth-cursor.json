{
  "source_key": "provider-oauth-example",
  "source_name": "Provider OAuth Example",
  "source_kind": "provider_api",
  "connector_key": "contacts-post",
  "url": "https://api.provider.example/v2/search",
  "method": "POST",
  "auth": {
    "type": "oauth2_client_credentials",
    "token_url": "https://api.provider.example/oauth/token",
    "client_id_env": "PROVIDER_CLIENT_ID",
    "client_secret_env": "PROVIDER_CLIENT_SECRET",
    "scope": "contacts.read"
  },
  "json_body": {
    "market": "automotive"
  },
  "response": {
    "format": "json",
    "records_path": "results"
  },
  "pagination": {
    "type": "cursor",
    "target": "json_body",
    "cursor_param": "cursor",
    "next_cursor_path": "meta.next_cursor",
    "max_pages": 100000
  }
}
